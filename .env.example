# Copy this file to .env and fill in real values. Never commit .env.

# --- Upstox developer app credentials (from Upstox Developer Console) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1/callback

# --- Live trading safety gate ---
# Must be explicitly set to true (in addition to mode: live in config/settings.yaml)
# before AlgoSathi will place real orders. Leave false/unset for paper trading.
LIVE_TRADING_CONFIRMED=false

# --- Supabase (optional) ---
# Syncs each fill to Supabase so the online dashboard (web/) can show it. Leave blank to run
# fully offline (local SQLite only, via scripts/dashboard.py). Use the service_role key here
# (never the anon key) — get it from Supabase Dashboard -> Project Settings -> API. Never
# commit this file with real values.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
